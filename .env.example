# MySQL connection for HK telemetry DB
# Copy this file to .env and replace the placeholder values with the real DB settings.
# Never commit a real .env file with credentials to version control.
MYSQL_HOST=your_mysql_host_or_ip
MYSQL_PORT=3306
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
MYSQL_DB=nstanl
MYSQL_SCHEMA=nstanl

# Alternative: set a full SQLAlchemy URL directly.
# MYSQL_CONNECTION_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3306/nstanl

# Optional: one of the satellite registry config files may be used instead of direct env vars.
# SATELLITE_CONFIG_PATH=config/satellites.toml

# Optional: require this value in the X-API-Key header for /telemetry, /footprint, /validator.
# If unset, auth is skipped (local development default). Set this in production.
# API_KEY=change_me

# Optional: comma-separated browser origins allowed to call this API directly (CORS).
# If unset, no cross-origin browser requests are allowed (server-to-server calls are unaffected).
# Only needed when a frontend (e.g. a Cesium viewer) fetches this API directly from the browser.
# CORS_ALLOWED_ORIGINS=https://dem.example.com,http://localhost:5173
